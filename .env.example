# AURA store configuration. `npm run setup` generates the real .env for you.
PORT=5000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:5000

GATEWAY_API_URL=http://127.0.0.1:6100
GATEWAY_CHECKOUT_URL=http://127.0.0.1:7000

MERCHANT_ID=00000000-0000-0000-0000-000000000001
MERCHANT_KEY=replace-with-the-gateway-webhook-secret
WEBHOOK_SECRET=replace-with-the-gateway-webhook-secret
ADMIN_API_TOKEN=replace-with-the-gateway-admin-token

DEMO_MODE=true
DEMO_AUTO_CONFIRM=true
STORE_DB_PATH=./data/store.sqlite
